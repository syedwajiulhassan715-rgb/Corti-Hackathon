{
  "name": "corti-hackathon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx src/main.ts",
    "test": "node --experimental-strip-types --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "npm --prefix web-next run build",
    "lint": "tsc --noEmit && npm --prefix web-next exec tsc -- --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "stage": "tsx src/main.ts",
    "demo": "node --import tsx src/server/index.ts",
    "start": "node --experimental-strip-types src/server/index.ts"
  },
  "dependencies": {
    "dotenv": "^17.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
